source 'https://rubygems.org'
gem 'github-pages', group: :jekyll_plugins

# Ruby 3.4+ removed these from the default gems, but the pinned Jekyll 3.9 (via
# github-pages) still requires them. Declaring them lets the site build locally
# on modern Ruby; harmless on GitHub Pages, which uses its own gem environment.
gem 'csv'
gem 'base64'
gem 'bigdecimal'
gem 'logger'
gem 'webrick'
